# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000
# Extra comma-separated origins allowed by CORS (optional)
CORS_ORIGINS=
# Only when frontend and API are on different subdomains, e.g. .example.com
COOKIE_DOMAIN=

# ── Data stores ───────────────────────────────────────────
# MongoDB Atlas connection string (include the database name)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/assistant?retryWrites=true&w=majority
# Redis from docker-compose (pnpm redis:up) listens on 6390
REDIS_URL=redis://localhost:6390

# ── Security ──────────────────────────────────────────────
# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=
# 32 bytes, base64. Encrypts OAuth tokens at rest. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ── Google OAuth ──────────────────────────────────────────
# See README → Google OAuth setup. Without these, sign-in shows "not configured".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ── Telegram ──────────────────────────────────────────────
# Create a bot with @BotFather. Without a token, Telegram is off.
TELEGRAM_BOT_TOKEN=
# polling (default in development, no public URL needed) | webhook (default in production) | off
TELEGRAM_MODE=
# Webhook mode only. Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Webhook mode only: public HTTPS base URL of this API, e.g. https://api.example.com
PUBLIC_API_URL=

# ── LLM (the agent) ───────────────────────────────────────
# Gemini API key from https://aistudio.google.com/apikey. Without it, plain messages get a
# "not configured" reply (slash commands still work).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
