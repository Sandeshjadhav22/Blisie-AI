# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000
# Extra comma-separated origins allowed by CORS (optional)
CORS_ORIGINS=

# ── Data stores ───────────────────────────────────────────
# MongoDB Atlas connection string (include the database name)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/assistant?retryWrites=true&w=majority
# Redis from docker-compose (pnpm redis:up) listens on 6390
REDIS_URL=redis://localhost:6390

# ── Security ──────────────────────────────────────────────
# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=
# 32 bytes, base64. Encrypts OAuth tokens at rest. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ── Google OAuth (Phase 2) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ── Telegram (Phase 3) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── LLM (Phase 6) ─────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=
